{
  "name": "ddao",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard da vida pessoal",
  "license": "MIT",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run services:up && npm run services:wait:database && npm run migrations:up && concurrently --names next,jest --hide next --kill-others --success command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "test:watch": "jest --runInBand --verbose --watchAll",
    "posttest": "npm run services:stop",
    "services:up": "docker compose --file infra/compose.yaml up --detach",
    "services:stop": "docker compose --file infra/compose.yaml stop",
    "services:down": "docker compose --file infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up",
    "migrations:down": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "commit": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "next": "15.5.25",
    "next-connect": "1.0.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/eslintrc": "3.3.7",
    "async-retry": "1.3.3",
    "commitizen": "4.3.2",
    "concurrently": "10.0.5",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.9.6"
  }
}
